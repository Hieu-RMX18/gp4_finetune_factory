{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GP4FineTuneMasterExample",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "messages", "expected_json", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gp4_[a-z]{2}_[a-z0-9_]+_[0-9]{6}$"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "robot_state": {
      "type": "object"
    },
    "scene_state": {
      "type": "object"
    },
    "reasoning_style": {
      "type": "string",
      "enum": ["react_ir"]
    },
    "react_trace": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_json": {
      "type": "object",
      "minProperties": 1
    },
    "react_ir": {
      "type": "object",
      "minProperties": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "task_type",
        "source",
        "safety_class",
        "requires_perception"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["vi", "en", "mixed"]
        },
        "task_type": {
          "type": "string",
          "enum": [
            "normal",
            "ambiguous",
            "hard_negative",
            "status",
            "vision_stub"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["seed", "synthetic", "eval"]
        },
        "safety_class": {
          "type": "string",
          "enum": [
            "safe_motion_plan",
            "safe_query",
            "safe_setting",
            "clarification_required",
            "unsafe_rejected",
            "perception_required"
          ]
        },
        "requires_perception": {
          "type": "boolean"
        },
        "scenario_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "singularity",
              "wrist_flip",
              "joint_wrap",
              "timeout_abort_recovery",
              "approval_required",
              "collision_limit_edge",
              "dangerous_os_command",
              "unsupported_tool_hallucination",
              "typo_noise",
              "alias_canonicalization",
              "vision_uncertain",
              "normal_motion",
              "status_query"
            ]
          }
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_dataset": {
          "type": "string",
          "enum": ["old", "new", "seed", "locked_eval"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["source_dataset"],
            "properties": {
              "source_dataset": {
                "const": "new"
              }
            }
          },
          "then": {
            "required": ["scenario_tags"],
            "properties": {
              "scenario_tags": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
