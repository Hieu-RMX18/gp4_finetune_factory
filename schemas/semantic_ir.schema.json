{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GP4SemanticIRGeneratorSchema",
  "type": "object",
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {"required": ["tool_name"]},
      {"required": ["command"]},
      {"required": ["shell_command"]},
      {"required": ["os_command"]},
      {"required": ["subprocess"]}
    ]
  },
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "go_home",
        "stop",
        "alarm_reset",
        "get_pose",
        "set_speed",
        "wait",
        "move_relative",
        "absolute_move_ptp",
        "move_named_pose",
        "absolute_move_lin",
        "circular_move",
        "move_joint",
        "move_joint_delta",
        "move_joints",
        "io_set",
        "draw_shape",
        "draw_text",
        "return_to_start",
        "sequence"
      ]
    },
    "error": {
      "type": "string",
      "enum": [
        "MISSING_SLOT",
        "UNSUPPORTED_OR_AMBIGUOUS_COMMAND",
        "UNSAFE_COMMAND",
        "PERCEPTION_REQUIRED",
        "CALIBRATION_REQUIRED"
      ]
    },
    "message": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "not": {
          "anyOf": [
            {"required": ["tool_name"]},
            {"required": ["command"]},
            {"required": ["shell_command"]},
            {"required": ["os_command"]},
            {"required": ["subprocess"]}
          ]
        }
      }
    }
  }
}
